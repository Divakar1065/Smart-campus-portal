# =====================================================================
# Academic Progress and Achievement Tracking System (ATS)
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your actual Aiven Cloud MySQL credentials below.
# 3. Do NOT commit .env containing real credentials into version control.
# =====================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
PYTHON_EXECUTABLE=python

# JWT Secret & Expiration for Session Security
JWT_SECRET=your_jwt_super_secret_key_change_me_in_production
JWT_EXPIRES_IN=24h

# Aiven Cloud MySQL Connection Credentials
# (Obtain from Aiven Console -> Services -> MySQL Service -> Overview)
DB_HOST=mysql-xxxxxxxx-your-account.aivencloud.com
DB_PORT=18334
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password_here

# SSL / TLS Settings for Aiven Cloud MySQL
# Aiven Cloud MySQL requires TLS. Set DB_SSL_MODE=REQUIRED or DB_SSL=true
DB_SSL_MODE=REQUIRED
DB_SSL=true

# Path to custom CA certificate if downloading ca.pem from Aiven Console
# If left empty, standard system/driver CA validation is used.
DB_CA_PATH=
DB_SSL_CA=

# Optional: Set to 'false' if connecting in development without custom ca.pem
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional External AI API Key (if using Google Gemini for LLM chat reasoning)
# GEMINI_API_KEY=your_gemini_api_key_here
