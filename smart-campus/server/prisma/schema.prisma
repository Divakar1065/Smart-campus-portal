// Smart Campus Management System
// Complete College Hierarchy: Dean → Department → HOD → Faculty → Student → Student Portal
// Prisma Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String
  role         String    // "ADMIN", "DEAN", "HOD", "FACULTY", "STUDENT"
  phone        String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  facultyProfile    Faculty?
  managedDepartment Department? @relation("DepartmentHOD")
  studentProfile    Student?
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model Department {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. "ECE", "CSE"
  name        String    @unique
  description String?
  hodId       Int?      @unique
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hod            User?          @relation("DepartmentHOD", fields: [hodId], references: [id])
  facultyMembers Faculty[]
  students       Student[]
  subjects       Subject[]
  notifications  Notification[]

  @@index([code])
}

model Faculty {
  id             Int       @id @default(autoincrement())
  facultyCode    String    @unique // e.g. "FAC-CSE-001"
  userId         Int       @unique
  departmentId   Int
  designation    String    // e.g. "Professor & HOD", "Associate Professor", "Assistant Professor"
  subjectsTaught String    @default("Core Engineering")
  joiningDate    DateTime  @default(now())
  maxCapacity    Int       @default(35)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students   Student[]

  @@index([facultyCode])
  @@index([departmentId])
  @@index([status])
}

model Student {
  id             Int       @id @default(autoincrement())
  studentId      String    @unique // e.g. "CSE2026001"
  userId         Int?      @unique
  name           String
  email          String    @unique
  phone          String?
  departmentId   Int
  facultyId      Int?
  academicYear   String    @default("2024-2028")
  semester       Int       @default(4)
  section        String    @default("A")
  enrollmentDate DateTime  @default(now())
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty    Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([departmentId])
  @@index([facultyId])
  @@index([status])
}

model Subject {
  id           Int      @id @default(autoincrement())
  code         String   // e.g. "CS401"
  name         String   // e.g. "Design and Analysis of Algorithms"
  credits      Int      @default(4)
  semester     Int      @default(4)
  departmentId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([departmentId])
}

model Notification {
  id           Int      @id @default(autoincrement())
  title        String
  message      String
  sender       String   // e.g. "Dean's Office", "HOD - CSE", "Academic Affairs"
  targetRole   String   @default("ALL") // "ALL", "STUDENT", "FACULTY", "HOD", "DEAN"
  departmentId Int?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([targetRole])
  @@index([departmentId])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}
