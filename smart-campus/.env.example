# Smart Campus Management System Environment Configuration
# Node Environment
NODE_ENV=development
PORT=5000

# SQLite Database Connection URL
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Encryption
JWT_SECRET=smart-campus-super-secret-key-2026

# Production Cross-Origin Settings
# Frontend Vercel URL
FRONTEND_URL=https://smart-campus-portal.vercel.app

# Frontend Client Environment Variable (used by Vite)
VITE_API_URL=https://smart-campus-api.onrender.com
